{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundDisc",
  "version": "0.2.0",
  "identifier": "local.sounddisc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundDisc",
        "width": 1540,
        "height": 1120,
        "minWidth": 1440,
        "minHeight": 1040,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ]
  }
}
